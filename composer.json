{
    "name": "woo-pdf-invoice/woo-pdf-invoice",
    "description": "Professional, sequential PDF invoices for WooCommerce orders.",
    "type": "wordpress-plugin",
    "version": "1.0.0",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=7.4",
        "ext-dom": "*",
        "ext-mbstring": "*",
        "dompdf/dompdf": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "WooPdfInvoice\\": "src/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "preferred-install": "dist"
    },
    "minimum-stability": "stable"
}
